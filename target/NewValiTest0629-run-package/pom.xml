    <build>
        <sourceDirectory>src/main/java</sourceDirectory> <!-- 待测试类的位置 如果只编译到codeing下面可能导致项目初期无法启动  -->
        <testSourceDirectory>src/test/java</testSourceDirectory> <!-- 测试类的位置 -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <excludes>
                        <exclude>TryCommons/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.8</version>
                <configuration>
                    <skip>false</skip>
                    <propertyName>jacocoArgLine</propertyName>
                    <destFile>${project.build.directory}/jacoco.exec</destFile>
                    <!-- 排除新建的工具类，只统计原始csv包的覆盖率 -->
                    <excludes>
                        <exclude>csv/Uncheck.class</exclude>
                        <exclude>csv/IOStream.class</exclude>
                        <exclude>csv/IOStream$*.class</exclude>
                        <exclude>csv/Base64OutputStream.class</exclude>
                        <exclude>csv/AppendableOutputStream.class</exclude>
                        <exclude>csv/IOUtilsHelper.class</exclude>
                        <exclude>csv/IOUtilsHelper$*.class</exclude>
                        <exclude>csv/AbstractStreamBuilder.class</exclude>
                        <exclude>csv/Charsets.class</exclude>
                        <exclude>csv/UnsynchronizedBufferedReader.class</exclude>
                        <exclude>lang3/builder/IDKey.class</exclude>
                        <exclude>lang3/reflect/AccessibleObjects.class</exclude>
                        <exclude>lang3/reflect/MemberUtils.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>zju.cst.aces.runner.NewValiTest0629</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
           <!-- <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                    <testClassesDirectory>${project.build.directory}/test-classes</testClassesDirectory>
                    <testSourceDirectory>src/test/java</testSourceDirectory>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                    </includes>
                </configuration>
            </plugin>-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version><!--原来运行0错误在这-->
                <configuration>
                    <skipTests>false</skipTests>
                    <argLine>${jacocoArgLine} -Dfile.encoding=UTF-8 -Xmx2048m -Xms512m</argLine>
                    <testClassesDirectory>${project.build.directory}/test-classes</testClassesDirectory>
                    <testSourceDirectory>src/test/java</testSourceDirectory>
                    <includes> <include>**/*Test.java</include></includes>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>

            </plugin>
        </plugins>
